<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/root"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <WebView
        android:id="@+id/web_view"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:importantForAccessibility="noHideDescendants" />

    <LinearLayout
        android:id="@+id/connection_setup"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="#0B0F14"
        android:gravity="center"
        android:orientation="vertical"
        android:padding="28dp"
        android:visibility="gone">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/connection_title"
            android:textColor="#F2F6FA"
            android:textSize="22sp"
            android:textStyle="bold" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="@string/connection_subtitle"
            android:textColor="#9AA5B1"
            android:textSize="14sp" />

        <EditText
            android:id="@+id/server_url_input"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            android:background="@drawable/bg_input"
            android:hint="@string/connection_hint"
            android:inputType="textUri"
            android:padding="14dp"
            android:textColor="#F2F6FA"
            android:textColorHint="#6B7683"
            android:textSize="16sp" />

        <Button
            android:id="@+id/connect_button"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:backgroundTint="#E8A33D"
            android:padding="10dp"
            android:text="@string/connection_connect"
            android:textColor="#0B0F14"
            android:textSize="16sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/connection_error"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:textColor="#FF6B6B"
            android:textSize="13sp"
            android:visibility="gone" />
    </LinearLayout>
</FrameLayout>